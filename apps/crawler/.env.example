# 복사해서 .env로 만들고 값을 채운다(.env는 git 제외). 실행: uv run --env-file .env python -m crawler --shop goldenchamps --save
CRAWLER_DB_HOST=localhost
CRAWLER_DB_PORT=5432
CRAWLER_DB_NAME=dummy_db
CRAWLER_DB_USER=dummy_user
CRAWLER_DB_PASSWORD=dummy_password
GOLDENCHAMPS_SHIPPING_FEE=0
BOXINGMALL_SHIPPING_FEE=0
# 복싱몰 중간 인증서(PEM) 파일 경로. 값은 본인 환경에 맞게 채운다. 예:
# BOXINGMALL_CA_FILE=/home/<사용자>/infra/jenkins/certs/boxingmall-intermediate.pem
